{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/skills/scanline/SKILL.md\"",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -c 'import json, pathlib, sys; print(json.dumps({\"hookSpecificOutput\": {\"hookEventName\": \"SubagentStart\", \"additionalContext\": pathlib.Path(sys.argv[1]).read_text(encoding=\"utf-8\")}}))' \"${CLAUDE_PLUGIN_ROOT}/skills/scanline/SKILL.md\"",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
